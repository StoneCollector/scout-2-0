# Scout Security Engine - Environment Template
# Copy this file to .env and insert your API keys

# Abuse.ch MalwareBazaar API Key (Optional for vendor lookups)
ABUSECH_KEY=your_abusech_api_key_here

# National Vulnerability Database (NVD) API Key (Optional)
NVD_KEY=your_nvd_api_key_here

# Custom SearXNG instance URL (Optional - defaults to rotating public SearXNG instances)
# SEARXNG_URL=https://your-searxng-instance.com

